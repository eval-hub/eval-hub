{
  "experiment": true,
  "model": {
    "name": "${JUDGE_MODEL_NAME}",
    "url": "${JUDGE_BASE_URL}"
  },
  "notes": "Stage one valid one-step ATIF trajectory; requires configured MLflow for artifact persistence.",
  "parameters": {
    "benchmark_name": "humanevalfix",
    "concurrency_limit": 1,
    "job_timeout_seconds": 120,
    "judge_max_attempts": 1,
    "max_steps_per_trajectory": 1,
    "max_total_steps": 1,
    "max_trajectory_files": 1,
    "scoring_mode": "benchmark"
  },
  "test_data_ref_env": "ATIF_TEST_DATA_REF",
  "timeout": "5m"
}
